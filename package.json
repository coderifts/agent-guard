{
  "name": "@coderifts/agent-guard",
  "version": "17.3.6",
  "description": "Signed, offline-verifiable authorization for API-contract changes. Only a granted change can proceed. This package is the fail-closed guard that wraps an agent’s tool calls.",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:markers": "node scripts/write-dist-type-markers.mjs",
    "build": "npm run clean && npm run build:cjs && npm run build:esm && npm run build:vendor && npm run build:markers",
    "lint": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build",
    "test": "node --test test/*.test.js",
    "check:packed": "node scripts/check-packed-install.js",
    "prepublishOnly": "node scripts/assert-changelog-version.js && bash \"${CODERIFTS_APP_ROOT:-$HOME/coderifts-app}/scripts/freeze-gate.sh\" && npm run build",
    "prepack": "node scripts/publish-package-json.mjs strip",
    "postpack": "node scripts/publish-package-json.mjs restore",
    "build:vendor": "node scripts/copy-vendor.mjs"
  },
  "keywords": [
    "coderifts",
    "agent",
    "guard",
    "governance",
    "ai-agent",
    "tool-safety",
    "fail-closed",
    "preflight",
    "api-contract-preflight",
    "offline-verifiable-authorization",
    "agent-authorization",
    "mcp"
  ],
  "author": "CodeRifts <hello@coderifts.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/coderifts/agent-guard.git"
  },
  "homepage": "https://coderifts.com",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@coderifts/sdk": "^3.10.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  },
  "peerDependencies": {
    "@coderifts/sdk": "^3.10.0"
  }
}
