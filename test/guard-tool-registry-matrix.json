        }
      },
      "derivation": "§1.5 forced readonly on mutator ⇒ BYPASSED; failHard false allows construction"
    },
    {
      "id": "GTR-011",
      "title": "classify override: Bash forced readonly via classify (same as force path)",
      "input": {
        "rawTools": [
          { "name": "Bash" }
