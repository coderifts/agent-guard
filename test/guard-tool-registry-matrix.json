      "expected": {
        "startup": "fail",
        "fail_code": "UNKNOWN_TOOL",
        "coverage": null,
        "tools": null
      },
      "derivation": "Unclassified + reject ⇒ throw before return"
    },
    {
      "id": "GTR-007",
      "title": "Unknown + unknownToolPolicy=readonly → PARTIAL (not COMPLETE)",
      "input": {
        "rawTools": [
