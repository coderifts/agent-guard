      "expected": {
        "startup": "ok",
        "coverage": "BYPASSED",
        "inescapable_runtime": false,
        "readonly_passthrough": ["Bash"],
        "guarded_mutators": [],
        "notes": "Explicit classify to readonly on shell tool is break-glass; BYPASSED. If failHard true, SPEC §1.5 should throw when heuristic was mutating_shell — treat classify readonly on shell name as FORCE_READONLY_MUTATOR when failHard"
