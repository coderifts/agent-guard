          "Write": { "guarded": true, "mutationClass": "mutating" },
          "Bash": { "guarded": true, "mutationClass": "mutating_shell" }
        }
      },
      "derivation": "M={Bash,Write} all wrapped; COMPLETE"
    },
    {
      "id": "GTR-009",
      "title": "forceReadonly on heuristic mutator Write + default failHard → startup fail",
      "input": {
