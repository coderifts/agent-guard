        "unguarded_mutators": [],
        "coverage": "COMPLETE",
        "inescapable_runtime": true,
        "notes": "Names sorted ASC in report; guarded=false on readonly is OK"
      },
      "derivation": "All readonly; M empty; COMPLETE"
    },
    {
      "id": "GTR-003",
      "title": "Single declared mutator Write — must be guarded",
      "input": {
        "rawTools": [
          { "name": "Write", "mutationClass": "mutating" }
        ],
        "config": {}
