    "date": "2026-07-29",
    "companion_spec": "guard-tool-registry-SPEC.md",
    "purpose": "Hand-re-derivable acceptance rows for guardToolRegistry. INVALID if COMPLETE with unguarded mutator, or startup_ok when forceReadonly on mutator with default failHard, or unknown→readonly yields COMPLETE.",
    "defaults": {
      "unknownToolPolicy": "mutating",
      "failOnUnguardedMutator": true,
      "allowRawMutators": false
    },
    "count": 16
  },
  "rows": [
    {
      "id": "GTR-001",
      "title": "Empty tool set",
      "input": {
        "rawTools": [],
        "config": {}
      },
      "expected": {
        "startup": "ok",
        "protected_names": [],
        "guarded_mutators": [],
        "readonly_passthrough": [],
        "unguarded_mutators": [],
        "coverage": "COMPLETE",
        "inescapable_runtime": true,
        "inescapable_merge": false
      },
      "derivation": "No tools ⇒ M=∅ G=∅ ⇒ COMPLETE; merge claim always false"
    },
    {
      "id": "GTR-002",
      "title": "Read-only tools only — passthrough unguarded",
      "input": {
        "rawTools": [
          { "name": "Read", "mutationClass": "readonly" },
          { "name": "Grep", "mutationClass": "readonly" },
          { "name": "Glob", "mutationClass": "readonly" }
