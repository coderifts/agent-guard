      "expected_if_failHard_default": {
        "startup": "fail",
        "fail_code": "FORCE_READONLY_MUTATOR",
        "notes": "Default config omit failOnUnguardedMutator ⇒ true ⇒ fail. This row uses false."
      },
      "derivation": "Declared classify wins but honesty: shell as readonly is BYPASSED when allowed"
    },
