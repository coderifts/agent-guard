    {
      "id": "AR-002",
      "title": "Multi-file OpenAPI: root unchanged listing but $ref'd component changed",
      "input": {
        "baseRef": "base",
        "headRef": "head",
        "changedFiles": ["spec/openapi.yaml", "spec/components.yaml"],
        "blobs": {
          "base:spec/openapi.yaml": "openapi: 3.0.0\ninfo: {title: t, version: 1.0.0}\npaths:\n  /pets:\n    get:\n      responses:\n        '200':\n          content:\n            application/json:\n              schema:\n                $ref: './components.yaml#/Pet'\n",
          "head:spec/openapi.yaml": "openapi: 3.0.0\ninfo: {title: t, version: 1.0.0}\npaths:\n  /pets:\n    get:\n      responses:\n        '200':\n          content:\n            application/json:\n              schema:\n                $ref: './components.yaml#/Pet'\n",
          "base:spec/components.yaml": "Pet:\n  type: object\n  properties:\n    id: {type: integer}\n    name: {type: string}\n",
          "head:spec/components.yaml": "Pet:\n  type: object\n  properties:\n    id: {type: integer}\n"
        },
        "config": { "openApiAssembly": "bundle_inline" }
      },
      "expected": {
        "coverage": "COMPLETE",
        "artifacts": [
          {
            "id": "openapi:spec/openapi.yaml",
            "type": "openapi",
            "assembly": "bundle_inline",
            "root": "spec/openapi.yaml",
            "includes_blobs": [
              "base:spec/openapi.yaml",
              "base:spec/components.yaml",
              "head:spec/openapi.yaml",
              "head:spec/components.yaml"
            ],
            "notes": "Single artifact at root; before/after assembled deterministically; component-only change visible in after bundle"
          }
        ],
        "unresolved": [],
        "ssot_selections": [
          { "chosen": "spec/openapi.yaml", "deferred": ["spec/components.yaml"], "reason": "single", "notes": "components is dependency not separate artifact when only supporting root; if both changed, root is the artifact id and components are inlined deps" }
        ],
        "notes": "If both root and components in changedFiles, produce ONE artifact for root with inlined components at each ref — not two openapi artifacts for the same surface"
      },
      "derivation": "§4 bundle_inline; components deferred as dependency; A1 assembly only from blobs"
    },
